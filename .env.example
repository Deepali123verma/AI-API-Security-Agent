# Local development defaults.
# For Docker Compose backend service, DATABASE_URL should use host `db` instead of `localhost`.
# Copy to `.env` and set a strong JWT_SECRET_KEY for local use.
# Never commit a real `.env` file.
#
# Vercel production: set these in the Vercel dashboard (not in git).
# Use a managed Postgres URL (Neon / Vercel Postgres). Run scripts/migrate_db.py once.

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/security_agent
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_BULK_FINDINGS=10

# Comma-separated browser origins allowed by CORS.
# Local: Vite + optional fullstack Docker port.
# Vercel: set to https://<your-project>.vercel.app (and custom domain if any).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional: path to a Vite production build for container same-origin serving.
# Leave unset on Vercel (SPA is copied to /public during build).
# STATIC_DIR=
