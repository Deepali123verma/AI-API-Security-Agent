# Local development defaults.
# For Docker Compose backend service, DATABASE_URL should use host `db` instead of `localhost`.
# Copy to `.env` and set a strong JWT_SECRET_KEY for local use.
# Never commit a real `.env` file.

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/security_agent
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_BULK_FINDINGS=10

# Comma-separated browser origins allowed by CORS (local Vite + optional local fullstack port).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional: path to a Vite production build for same-origin SPA serving.
# In the production Docker image this is set to /app/static automatically.
# STATIC_DIR=
